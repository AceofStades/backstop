# Razorpay TEST MODE credentials only.
# Dashboard -> toggle to "Test Mode" -> Settings -> API Keys -> Generate Test Key
# The key MUST start with rzp_test_. The executor refuses to start otherwise.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Used by the diagnoser's LLM fallback classifier.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional: model override for the diagnoser.
DIAGNOSER_MODEL=claude-sonnet-5
